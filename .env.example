# Frontend Supabase settings — use the anon/publishable key, never service_role.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Vercel backend only — OpenAI-compatible Chat Completions endpoint.
AI_API_URL=https://YOUR-PROVIDER.example/v1/chat/completions
AI_API_KEY=YOUR_SECRET_API_KEY
AI_MODEL=YOUR_MODEL_ID
